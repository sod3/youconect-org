# No external services needed for local development. Files persist in .data/.
APP_URL=http://localhost:3000
PORT=3000
# Set to an external PostgreSQL connection string for production.
# DATABASE_URL=postgresql://youconect:change-me@localhost:5432/youconect
DATA_DIR=.data
# Explicitly opt in to fictional demo fixtures (never enable on a real institution).
DEMO_ENABLED=true
# Production registration / verification / password recovery require SMTP.
# SMTP_URL=smtps://username:password@smtp.example.com:465
# MAIL_FROM=YouConect <hello@example.com>
# TRUST_PROXY=true
# Required in production to encrypt authenticator secrets. Generate 32 random bytes as hex.
# AUTH_ENCRYPTION_KEY=
